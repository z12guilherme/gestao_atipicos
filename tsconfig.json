{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Para maior qualidade e segurança do código, recomendo habilitar o modo estrito.
    // Isso pode exigir alguns ajustes no código para tratar nulos e tipos implícitos,
    // mas o ganho em robustez é imenso.
    "strict": true,
    "skipLibCheck": true
  }
}
